{
  "name": "codex-s",
  "version": "0.1.8",
  "description": "A CLI for listing and deleting local Codex sessions.",
  "type": "module",
  "bin": {
    "cx": "bin/cx.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dylan-Liew/codex-s.git"
  },
  "homepage": "https://github.com/Dylan-Liew/codex-s#readme",
  "bugs": {
    "url": "https://github.com/Dylan-Liew/codex-s/issues"
  },
  "keywords": [
    "codex",
    "cli",
    "sessions"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "smoke:node": "node ./dist/cli/index.js help",
    "start": "node ./dist/cli/index.js",
    "test": "npm run build && node --test tests/*.test.mjs && npm run smoke:node"
  },
  "dependencies": {
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/yargs": "^17.0.35",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
